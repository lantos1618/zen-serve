    ).try();
    serve             = b.lib(
        "serve",
        {src: Path("src/serve/serve.zen"), libs: [], paths: []}
    ).try();
    b.exe_test(
        "unit",
        {src: Path("tests/unit.zen"), deps: [serve], out: Ok(Path("build/unit-tests"))}
    ).try();
    b.exe_test(
        "live",
        {src: Path("tests/live.zen"), deps: [serve, http, workers, aead_nonce, aes_gcm, bits64, chacha20poly1305, der, ec_key, ecdsa, ecdsa_p384, ff, hkdf, hkdf_sha2x64, hmac_sha256, hmac_sha2x64, hmac_sha512, p256, p256_fiat, p256_scalar, p384, p384_fiat, p384_scalar, pem, rsa, sha256, sha2x64, sha512, sodium_utils, tls13, tls13_cert_client, tls13_cert_config, tls13_cert_server, tls13_server, tls13_session, tls13_sha384, x25519, x509, x509_roots, x509_verify], out: Ok(Path("build/live-tests"))}
    ).try();
    b.exe(
        "zen-serve",
        {src: Path("src/main.zen"), deps: [serve, http, workers, aead_nonce, aes_gcm, bits64, chacha20poly1305, der, ec_key, ecdsa, ecdsa_p384, ff, hkdf, hkdf_sha2x64, hmac_sha256, hmac_sha2x64, hmac_sha512, p256, p256_fiat, p256_scalar, p384, p384_fiat, p384_scalar, pem, rsa, sha256, sha2x64, sha512, sodium_utils, tls13, tls13_cert_client, tls13_cert_config, tls13_cert_server, tls13_server, tls13_session, tls13_sha384, x25519, x509, x509_roots, x509_verify], out: Ok(Path("build/zen-serve"))}
    ).try();
    b.exe(
        "zen-serve-linux",
        {src: Path("src/main_linux.zen"), deps: [serve, http, workers, aead_nonce, aes_gcm, bits64, chacha20poly1305, der, ec_key, ecdsa, ecdsa_p384, ff, hkdf, hkdf_sha2x64, hmac_sha256, hmac_sha2x64, hmac_sha512, p256, p256_fiat, p256_scalar, p384, p384_fiat, p384_scalar, pem, rsa, sha256, sha2x64, sha512, sodium_utils, tls13, tls13_cert_client, tls13_cert_config, tls13_cert_server, tls13_server, tls13_session, tls13_sha384, x25519, x509, x509_roots, x509_verify], out: Ok(Path("build/zen-serve-linux"))}
    ).try();
