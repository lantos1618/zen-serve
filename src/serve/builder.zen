// The Builder actor: runs the project's build command, one build at a time,
// and tells the Server how it went.
//
// A build runs inside one message turn (the command's process is awaited on
// this actor's own thread), so change notifications that arrive meanwhile
// queue in the mailbox; `BuildQueue` turns any number of them into exactly
// one follow-up build.
Alloc, AllocError, Ptr, null_ptr = std.mem
str, String = std.text
Sink, WriteError = std.core.io
TransportBackend = http.server_core
BuildQueue = serve.watch
Server, Wake = serve.server

// Diagnostics beyond this are cut; the overlay is for reading, not archiving.
MAX_DIAGNOSTICS: usize = 65536

// Keep draining both child pipes after the display budget is exhausted.
BoundedDiagnostics = { data :: String }
BoundedDiagnostics.impl(Sink, {
    write = (self :: @Self, bytes: str) Res<(), WriteError> {
        remaining = MAX_DIAGNOSTICS - self.data.len();
        self.data.add(bytes.slice(0, bytes.len.min(remaining))).try();
        Ok(())
    }

    write_byte = (self :: @Self, byte: u8) Res<(), WriteError> {
        (self.data.len() < MAX_DIAGNOSTICS).then(
            () { self.data.add(byte).try(); }
        );
        Ok(())
    }
})

BuildOutcome* = { ok*: bool, diagnostics*: str, millis*: u64 }

// Runs `command` through /bin/sh in `project`. Success is exit status zero;
// on failure the diagnostics are the command's stderr then stdout (Zen
// reports errors on stderr), prefixed with the command and its status.
run_build* = (
    env     : Env,
    a       : Alloc,
    project : str,
    command : str
) Res<BuildOutcome, AllocError> {
    started = env.clock.since_start().millis_of();
    argv ::= a.Vec<str>();
    argv.add("/bin/sh").try();
    argv.add("-c").try();
    argv.add(command).try();
    argv.add("sh").try();
    out ::= BoundedDiagnostics(data: a.String().try());
    err ::= BoundedDiagnostics(data: a.String().try());
    result = env.proc.run_argv_into(a, project, argv, out, err);
    millis = env.clock.since_start().millis_of() - started;
    result.match({
        Err(_)   => {
            text = a.String(
                "$ {}\ncould not start /bin/sh for the build command\n",
                command
            ).try();
            Ok(BuildOutcome(
                ok: false,
                diagnostics: text.view(),
                millis: millis
            ))
        },
        Ok(code) => (code == 0).match({
            true  => Ok(BuildOutcome(
                ok: true,
                diagnostics: "",
                millis: millis
            )),
            false => {
                text ::= a.String(
                    "$ {}\nexit status {}\n\n",
                    command,
                    code
                ).try();
                text.add(err.data.view()).try();
                (out.data.len() > 0).then(() {
                    (text.len() > 0 && !text.view().ends_with("\n")).then(() { text.add('\n').try(); });
                    text.add(out.data.view()).try();
                });
                view    = text.view();
                clipped = (view.len > MAX_DIAGNOSTICS).match({
                    true  => view.slice(0, MAX_DIAGNOSTICS),
                    false => view,
                });
                Ok(BuildOutcome(
                    ok: false,
                    diagnostics: clipped,
                    millis: millis
                ))
            },
        }),
    })
}

Builder*<B: TransportBackend> = {
    project: str,
    command: str,
    server: Ref<Server<B>>,
    wake: Wake,
    queue :: BuildQueue = BuildQueue(),
    byte :: Ptr<u8> = null_ptr<u8>(),
    builds :: usize = 0,
    pending_changes :: usize = 0,

    ring = (self :: @Self, ctx: Context) {
        self.byte.is_null().then(() {
            self.byte = ctx.alloc.raw(
                8,
                8
            ).match({ Ok(p) => p, Err(_) => null_ptr<u8>() });
        });
        (!self.byte.is_null()).then(() { self.wake.ring(self.byte); });
    }

    build = (self :: @Self, ctx: Context, changes: usize) {
        self.builds = self.builds + 1;
        self.server.building(self.server).ignore();
        self.ring(ctx);
        ctx.env.out.println(
            "zen-serve: rebuilding ({} change notification(s))",
            changes
        ).ignore(); ctx.env.out.flush().ignore();
        scratch = ctx.env.mem.alloc();
        run_build(ctx.env, scratch, self.project, self.command).match({
            Err(_)      => (),
            Ok(outcome) => {
                outcome.ok.match({
                    true  => {
                        ctx.env.out.println(
                            "zen-serve: build ok in {} ms",
                            outcome.millis
                        ).ignore(); ctx.env.out.flush().ignore();
                        self.server.built(self.server).ignore();
                    },
                    false => {
                        ctx.env.out.println(
                            "zen-serve: build failed in {} ms\n{}",
                            outcome.millis,
                            outcome.diagnostics
                        ).ignore(); ctx.env.out.flush().ignore();
                        self.server.failed(
                            self.server,
                            outcome.diagnostics
                        ).ignore();
                    },
                });
                self.ring(ctx);
            },
        });
    }
}

Builder.impl(Actor, {
    // Sent by the Watcher once a burst of changes has settled.
    changed = (self :: @Self, ctx: Context, me: Ref<Builder<B>>, changes: usize) {
        self.pending_changes = self.pending_changes + changes;
        self.queue.changed().then(() { me.run(me).ignore(); });
    }
    run = (self :: @Self, ctx: Context, me: Ref<Builder<B>>) {
        self.queue.run().then(() {
            changes              = self.pending_changes;
            self.pending_changes = 0;
            self.build(ctx, changes);
        });
    }
})
